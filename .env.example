# ─────────────────────────────────────────────
#  SyncHub — príklad premenných prostredia
#  Skopírujte do .env a vyplňte hodnoty
# ─────────────────────────────────────────────

# PostgreSQL connection string (povinné)
DATABASE_URL=postgres://user:password@localhost:5432/synchub

# Tajný kľúč pre session cookies (povinné, min. 32 znakov)
SESSION_SECRET=zmenit-na-nahodny-retazec-min-32-znakov

# Port servera (voliteľné, default: 5000)
PORT=5000

# ─── Google Drive zálohy (voliteľné) ─────────
# Service Account JSON — celý obsah JSON súboru na jednom riadku
# Postup: Google Cloud Console → IAM → Service Accounts → Create → Download JSON
# Potom zdieľajte cieľový Google Drive priečinok so service account emailom
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ID Google Drive priečinka pre zálohy (voliteľné, default: 0AJCiYKbj09exUk9PVA)
GOOGLE_DRIVE_TARGET_FOLDER_ID=0AJCiYKbj09exUk9PVA

# ─── Stricker Europe ─────────────────────────
STICKER_ACCESS_KEY=
STICKER_CLIENT_ID=

# ─── PF Concept ──────────────────────────────
PFCONCEPT_USERNAME=
PFCONCEPT_PASSWORD=

# ─── Promotron e-shop ────────────────────────
PROMOLOG_USERNAME=
PROMOLOG_PASSWORD=
